# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=music_room
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Social Authentication
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Geocoding API key — powers GET /api/v1/geocode/, which the web
# client uses in place of the (web-unsupported) `geocoding` Flutter plugin.
# Needs the "Geocoding API" enabled on this key in Google Cloud Console.
GOOGLE_API_KEY=your-google-api-key

# Web client origins allowed by CORS/CSRF (comma-separated). Mobile builds
# never send an Origin header, so they were never gated by this — it's only
# needed now that a browser is a client too. See docs/WEB_BONUS.md.
CORS_ALLOWED_ORIGINS=http://localhost:5000
CSRF_TRUSTED_ORIGINS=http://localhost:5000

# Django Secret Key
SECRET_KEY=your-secret-key-here

# Frontend URL
FRONTEND_URL=http://localhost:3000
